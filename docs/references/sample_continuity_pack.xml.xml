  <RELATIONSHIPS>
    <PAIR source="Rudeus" target="Sylphiette" rtas="5.0" pair="Anh-Em" notes="Vợ chồng gắn kết sâu sắc, Sylphiette sinh con gái đầu lòng (Lucy) và bao dung chấp nhận Roxy làm vợ thứ hai." />
    <PAIR source="Rudeus" target="Roxy" rtas="4.9" pair="Em-Sư phụ" notes="Từ thầy trò trở thành người tri kỷ, trải qua sinh tử và chính thức kết hôn, trở thành vợ thứ hai của Rudeus." />
    <PAIR source="Rudeus" target="Norn" rtas="3.8" pair="Anh-Em" notes="Đã vượt qua hiểu lầm về cái chết của cha, Norn dần mở lòng và xin Rudeus dạy kiếm thuật." />
    <PAIR source="Rudeus" target="Aisha" rtas="4.0" pair="Anh-Em" notes="Gắn bó, Aisha hỗ trợ đắc lực việc gia đình và chăm sóc các thành viên." />
    <PAIR source="Rudeus" target="Geese" rtas="4.0" pair="Tôi-Cậu" notes="Quan hệ tiền bối lính mới, dù chỉ gặp nhau ít lâu nhưng đã trở nên thân thiết" />
    <PAIR source="Rudeus" target="Zenith" rtas="4.5" pair="Con-Mẹ" notes="Giải cứu thành công nhưng Zenith đã bị tổn thương não bộ, mất trí nhớ và phế nhân; Rudeus và gia đình quyết định chăm sóc chu đáo." />
    <PAIR source="Rudeus" target="Paul" rtas="4.5" pair="Con-Cha" notes="Giải cứu thành công nhưng Zenith đã bị tổn thương não bộ, mất trí nhớ và phế nhân; Rudeus và gia đình quyết định chăm sóc chu đáo." />
    <PAIR source="Rudeus" target="Talhand" rtas="3.5" pair="Cháu-Bác" notes="Gặp nhau trong nhiệm vụ giải cứu Zenith, hỗ trợ chỉ dạy Rudeus phương pháp tấn công trong Mê cung Dịch chuyển" />
    <PAIR source="Talhand" target="Rudeus" rtas="4.0" pair="Ta-Nhóc" notes="Là bạn đồng hành cùng Paul năm xưa. Gặp nhau trong nhiệm vụ giải cứu Zenith, hỗ trợ chỉ dạy Rudeus phương pháp tấn công trong Mê cung Dịch chuyển; Có cảm tình vì sự nhanh nhạy và thông minh của cậu" />
    <PAIR source="Geese" target="Rudeus" rtas="4.0" pair="Tôi-Cậu" notes="Quan hệ tiền bối lính mới, dù chỉ gặp nhau ít lâu nhưng đã trở nên thân thiết" />
    <PAIR source="Geese" target="Elinalise" rtas="4.0" pair="Tôi-Cô" notes="Từng là đồng hữu cùng chung tổ đội với nhau nhưng rồi tách ra, đến khi tham gia việc giải cứu Zenith mới gặp lại" />
    <PAIR source="Geese" target="Paul" rtas="4.5" pair="Tôi-Cậu" notes="Tôn trọng, từng là đồng đội cũng như giúp đỡ tham gia việc giải cứu Zenith" />
    <PAIR source="Sylphiette" target="Roxy" rtas="4.5" pair="Em-Chị" notes="Bao dung, thấu hiểu và kết nghĩa chị em, cùng nhau xây dựng gia đình chung chồng." />
    <PAIR source="Lilia" target="Zenith" rtas="4.5" pair="Tôi-Chị" notes="Trung thành tuyệt đối, tận tụy chăm sóc Zenith sau khi được giải cứu." />
    <PAIR source="Lilia" target="Rudeus" rtas="4.5" pair="Tôi-Cậu chủ/Cậu" notes="Tôn trọng, tin tưởng tuyệt đối Rudeus vì năm xưa đã từng cứu giúp cô" />
    <PAIR source="Lilia" target="Paul" rtas="4.5" pair="Tôi-Ông chủ/Anh" notes="Tôn trọng, tin tưởng tuyệt đối Rudeus vì năm xưa đã từng cứu giúp cô" />
    <PAIR source="Paul" target="Geese" rtas="4.5" pair="Tôi-Cậu" notes="Tôn trọng, từng là đồng đội" />
    <PAIR source="Paul" target="Lilia" rtas="4.8" pair="Anh-Em" notes="Đồng hành cùng nhau trên hành trình đến nơi Zenith bị giam cầm, dù không đi cùng trong chuyến thám hiểm nhưng là hậu phương vững chắc" />
    <PAIR source="Paul" target="Rudeus" rtas="4.5" pair="Cha-Con" notes="Cha con, dù từng có xích mích trong quá khứ nhưng đã hòa giải, từ đó thân thiết và tôn trọng nhau hơn. Paul còn tự hào vì có người con giỏi giang, thông minh" />
    <PAIR source="Talhand" target="Roxy" rtas="4.0" pair="Ta-Cô" notes="Là bạn đồng hành trong nhiệm vụ giải cứu Zenith." />
    <PAIR source="Roxy" target="Talhand" rtas="4.0" pair="Tôi-Bác" notes="Là bạn đồng hành trong nhiệm vụ giải cứu Zenith." />
    <PAIR source="Roxy" target="Rudeus" rtas="4.0" pair="Tôi-Em" notes="Từ thầy trò trở thành người tri kỷ, trải qua sinh tử và chính thức kết hôn, trở thành vợ thứ hai của Rudeus." />
    <PAIR source="Roxy" target="Sylphiette" rtas="4.5" pair="Chị-Em" notes="Bao dung, thấu hiểu và kết nghĩa chị em, cùng nhau xây dựng gia đình chung chồng." />
    <PAIR source="Roxy" target="Zenith" rtas="4.5" pair="Tôi-Chị" notes="Biết ơn, có cảm tình vì năm xưa hai vợ chồng đã giúp đỡ cô ăn ở, quan tâm đến cô." />
    <PAIR source="Roxy" target="Paul" rtas="4.5" pair="Tôi-Anh" notes="Biết ơn, có cảm tình vì năm xưa hai vợ chồng đã giúp đỡ cô ăn ở, quan tâm đến cô." />
